<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\..\..\common.props" />
    <Import Project="..\..\..\..\configureawait.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>
            Elsa Workflow Settings is an optional part of Elsa Workflows.
            This package provides a YesSql persistence provider.
        </Description>
        <PackageTags>elsa, workflow settings, orchard</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="YesSql.Core" Version="5.4.7" />
        <PackageReference Include="YesSql.Provider.MySql" Version="5.4.7" />
        <PackageReference Include="YesSql.Provider.PostgreSql" Version="5.4.7" />
        <PackageReference Include="YesSql.Provider.Sqlite" Version="5.4.7" />
        <PackageReference Include="YesSql.Provider.SqlServer" Version="5.4.7" />
    </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\Elsa.Core\Elsa.Core.csproj" />
    <ProjectReference Include="..\..\..\persistence\Elsa.Persistence.YesSql\Elsa.Persistence.YesSql.csproj" />
    <ProjectReference Include="..\Elsa.WorkflowSettings\Elsa.WorkflowSettings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="ConfigureAwait.Fody" Version="3.4.0" />
    <PackageReference Update="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.203" />
  </ItemGroup>

</Project>
